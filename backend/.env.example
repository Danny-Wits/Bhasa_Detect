# Environment variables for Backend (FastAPI)
# Port is set automatically by Render in production
PORT=8000
ENVIRONMENT=production

# Strong secret key for JWT session tokens
SECRET_KEY=replace-with-a-secure-random-secret-key

# Optional: Comma-separated list of allowed origins, or * for all
ALLOWED_ORIGINS=*

# Optional: PostgreSQL connection string (defaults to SQLite if not provided)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
